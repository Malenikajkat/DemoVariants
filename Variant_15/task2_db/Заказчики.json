[
  // Что такое JSON?
  // JSON (JavaScript Object Notation) — это формат для хранения данных.
  // Он похож на текст, но структурированный.
  // Представьте, что это как список карточек с информацией о клиентах.
  
  // Структура JSON:
  // [ ] — это массив (список)
  // { } — это объект (карточка с полями)
  // "ключ": "значение" — это поле
  
  // Пример:
  // [
  //   {
  //     "id": "000000001",
  //     "name": "ООО \"Поставка\"",
  //     ...
  //   },
  //   {
  //     "id": "000000002",
  //     "name": "ИП Жуков А.В.",
  //     ...
  //   }
  // ]
  
  // Каждая карточка содержит:
  // - id: уникальный номер (строка из цифр)
  // - name: название компании или ФИО
  // - inn: ИНН организации (может быть пустым)
  // - addres: адрес (опечатка в поле сохранена для совместимости)
  // - phone: телефон
  // - type: тип клиента ("Поставщик" или "Покупатель")

  // ==================== КЛИЕНТ 1: ПОСТАВЩИК ====================
  {
    "id": "000000001",
    "name": "ООО \"Поставка\"",
    "inn": "",
    "addres": "г. Пятигорск",
    "phone": "+79198634592",
    "type": "Поставщик"
  },
  
  // ==================== КЛИЕНТ 2: ПОКУПАТЕЛЬ ====================
