{
  "info": {
    "name": "Задание 5 — Стоматология Улыбка",
    "description": "Тестовая коллекция для API заметок стоматологии «Улыбка». Содержит тесты на статус 200, 500 и валидность JSON.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GET /api/notes — Получение заметок",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
                "// ============================================",
                "// ТЕСТЫ ДЛЯ GET /api/notes",
                "// ============================================",
                "",
                "// Тест 1: Проверка статуса 200 OK",
                "pm.test(\"Статус код должен быть 200 OK\", function () {",
                "    pm.response.to.have.status(200);",
                "});",
                "",
                "// Тест 2: Проверка валидности JSON",
                "pm.test(\"Ответ должен быть в формате JSON\", function () {",
                "    pm.response.to.be.json;",
                "});",
                "",
                "// Тест 3: Проверка, что ответ — массив",
                "pm.test(\"Ответ должен быть массивом\", function () {",
                "    var jsonData = pm.response.json();",
                "    pm.expect(jsonData).to.be.an('array');",
                "});",
                "",
                "// Тест 4: Проверка структуры элементов",
                "pm.test(\"Каждая заметка должна содержать все поля\", function () {",
                "    var jsonData = pm.response.json();",
                "    if (jsonData.length > 0) {",
                "        pm.expect(jsonData[0]).to.have.property('id');",
                "        pm.expect(jsonData[0]).to.have.property('title_user');",
                "        pm.expect(jsonData[0]).to.have.property('content');",
                "        pm.expect(jsonData[0]).to.have.property('formatted_date');",
                "",
                "        // Проверяем формат title_user: \"{title} - {login}\"",
                "        pm.expect(jsonData[0].title_user).to.match(/^.+ - .+$/);",
                "",
                "        // Проверяем формат даты: ДД.ММ.ГГГГ",
                "        pm.expect(jsonData[0].formatted_date).to.match(/^\\\\d{2}\\\\.\\\\d{2}\\\\.\\\\d{4}$/);",
                "",
                "        // Проверяем, что content не пустой",
                "        pm.expect(jsonData[0].content).to.be.a('string').and.to.have.lengthOf.greaterThan(0);",
                "    }",
                "});",
                "",
                "// Тест 5: Проверка количества заметок (не менее 3)",
                "pm.test(\"Должно быть не менее 3 заметок\", function () {",
                "    var jsonData = pm.response.json();",
                "    pm.expect(jsonData.length).to.be.at.least(3);",
                "});",
                "",
                "// Тест 6: Проверка заголовка Content-Type",
                "pm.test(\"Content-Type должен быть application/json\", function () {",
                "    pm.response.to.be.header('Content-Type');",
                "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/notes",
          "protocol": "http",
          "host": ["{{base_url}}"],
          "path": ["api", "notes"]
        },
        "description": "Эндпоинт возвращает все заметки из таблицы notes с преобразованными данными:\n- id — идентификатор заметки\n- title_user — конкатенация title и login (формат: \"{title} - {login}\")\n- content — содержание заметки\n- formatted_date — дата в формате ДД.ММ.ГГГГ\n\nТесты:\n1. Статус 200 OK\n2. Ответ в формате JSON\n3. Ответ — массив\n4. Проверка структуры полей\n5. Не менее 3 заметок\n6. Content-Type: application/json"
      },
      "response": []
    },
    {
      "name": "GET / — Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
                "// ============================================",
                "// ТЕСТЫ ДЛЯ GET /",
                "// ============================================",
                "",
                "// Тест 1: Проверка статуса 200 OK",
                "pm.test(\"Статус код должен быть 200 OK\", function () {",
                "    pm.response.to.have.status(200);",
                "});",
                "",
                "// Тест 2: Проверка валидности JSON",
                "pm.test(\"Ответ должен быть в формате JSON\", function () {",
                "    pm.response.to.be.json;",
                "});",
                "",
                "// Тест 3: Проверка сообщения",
                "pm.test(\"Должно быть поле message\", function () {",
                "    var jsonData = pm.response.json();",
                "    pm.expect(jsonData.message).to.exist;",
                "    pm.expect(jsonData.message).to.include('работает');",
                "});",
                "",
                "// Тест 4: Проверка версии",
                "pm.test(\"Должно быть поле version\", function () {",
                "    var jsonData = pm.response.json();",
                "    pm.expect(jsonData.version).to.exist;",
                "    pm.expect(jsonData.version).to.eql('1.0.0');",
                "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "protocol": "http",
          "host": ["{{base_url}}"],
          "path": [""]
        },
        "description": "Корневой эндпоинт для проверки работоспособности сервера.\nВозвращает сообщение и версию API."
      },
      "response": []
    },
    {
      "name": "Test 500 Error — DB Down",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
                "// ============================================",
                "// ТЕСТЫ ДЛЯ ОШИБКИ 500",
                "// ============================================",
                "// Инструкция:",
                "// 1. Остановите PostgreSQL: Stop-Service postgresql_x64-16",
                "// 2. Отправьте этот запрос",
                "// 3. Проверьте результаты тестов",
                "// 4. Запустите PostgreSQL: Start-Service postgresql_x64-16",
                "",
                "// Тест 1: Проверка статуса 500 при недоступности БД",
                "pm.test(\"При ошибке БД должен быть статус 500\", function () {",
                "    if (pm.response.code === 500) {",
                "        pm.expect(pm.response.code).to.eq(500);",
                "    } else {",
                "        // Если БД работает — пропускаем этот тест",
                "        pm.test(\"БД работает — тест 500 пропущен\", function () {",
                "            pm.expect(true).to.be.true;",
                "        });",
                "    }",
                "});",
                "",
                "// Тест 2: Проверка JSON с полем error при ошибке",
                "pm.test(\"При ошибке возвращается JSON с полем error\", function () {",
                "    if (pm.response.code === 500) {",
                "        var jsonData = pm.response.json();",
                "        pm.expect(jsonData).to.have.property('error');",
                "        pm.expect(jsonData.error).to.be.a('string');",
                "        pm.expect(jsonData.error.length).to.be.greaterThan(0);",
                "    }",
                "});",
                "",
                "// Тест 3: Проверка Content-Type при ошибке",
                "pm.test(\"Content-Type при ошибке — application/json\", function () {",
                "    if (pm.response.code === 500) {",
                "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                "    }",
                "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/notes",
          "protocol": "http",
          "host": ["{{base_url}}"],
          "path": ["api", "notes"]
        },
        "description": "Тест обработки внутренней ошибки сервера.\n\nКак протестировать:\n1. Остановите PostgreSQL: Stop-Service postgresql_x64-16\n2. Нажмите Send\n3. Должен получить статус 500\n4. Проверьте тело ответа: {\"error\": \"...\"}\n5. Запустите PostgreSQL: Start-Service postgresql_x64-16\n\nТесты:\n1. Статус 500 при недоступности БД\n2. JSON с полем error\n3. Content-Type: application/json"
      },
      "response": []
    }
  ]
}
